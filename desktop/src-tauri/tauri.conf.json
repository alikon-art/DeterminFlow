{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeterminFlow",
  "version": "1.0.7",
  "identifier": "io.determinflow.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeterminFlow",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "publisher": "DeterminFlow Contributors",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../runtime/backend/": "runtime/backend/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "headerImage": "images/nsis-header.bmp",
        "sidebarImage": "images/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "images/nsis-header.bmp",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/alikon-art/DeterminFlow/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBRkY1NkI2MjQ1NUM1OTkKUldTWnhWVWt0bGIvU21EaysvZ1hQaVVUOEc3VFFISEY5aTBPQlZFdHNURDFSejlSTk1pM1NhL24K"
    }
  }
}
